# Copy to .env (repo root or backend/). All values are optional; defaults work locally.

# --- Local models (Ollama) ---
COMEBLOG_OLLAMA_HOST=http://localhost:11434
COMEBLOG_OLLAMA_MODEL=qwen2.5:3b
COMEBLOG_EVALUATOR_MODEL=qwen3:4b
COMEBLOG_OLLAMA_TEMPERATURE=0.4
COMEBLOG_OLLAMA_TIMEOUT_S=240

# --- Research (Wikipedia + Wikimedia Commons are free and on by default) ---
COMEBLOG_WIKIPEDIA_ENABLED=true
# REQUIRED for Wikipedia/Commons: Wikimedia's robot policy (https://w.wiki/4wJS) blocks
# clients that do not identify themselves. Use a URL or email you control.
COMEBLOG_CONTACT=
# Optional: adds current web results. Get a key at https://tavily.com
COMEBLOG_TAVILY_API_KEY=
COMEBLOG_TAVILY_SEARCH_DEPTH=advanced
COMEBLOG_TAVILY_MAX_RESULTS=5
COMEBLOG_MAX_SOURCES=6
COMEBLOG_DOWNLOAD_IMAGES=true

# --- Quality ---
COMEBLOG_PASS_THRESHOLD=0.7
COMEBLOG_MAX_ATTEMPTS=2
COMEBLOG_LLM_REVIEW=true

# --- Site ---
COMEBLOG_SITE_TITLE=Come-Blog
COMEBLOG_SITE_TAGLINE=Researched, written and illustrated locally.
COMEBLOG_AUTHOR_NAME=Come-Blog
# Public URL used in canonical links, RSS and the sitemap
COMEBLOG_BASE_URL=http://localhost:8000

# --- Server hardening ---
# When set, every endpoint except /health requires the X-API-Key header.
COMEBLOG_API_KEY=
COMEBLOG_CORS_ORIGINS=http://localhost:8501,http://localhost:8000
COMEBLOG_RATE_LIMIT_PER_MINUTE=30
COMEBLOG_MAX_CONCURRENT_JOBS=1
COMEBLOG_MAX_QUEUED_JOBS=10
# Only enable behind a trusted reverse proxy that sets X-Forwarded-For
COMEBLOG_TRUST_PROXY_HEADERS=false

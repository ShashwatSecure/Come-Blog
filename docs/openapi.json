{
  "openapi": "3.1.0",
  "info": {
    "title": "Come-Blog API",
    "description": "\nLocal-first blog generator. Submit a topic and the service researches it (Wikipedia, Wikimedia Commons, Tavily),\nplans and writes a cited article with a local Ollama model, runs deterministic quality gates, and publishes a static\nblog under `/site`.\n\n**Typical flow**\n\n1. `POST /preview` (optional): see the research that would be used. No model is called.\n2. `POST /blogs`: returns `202` and a job id.\n3. Poll `GET /jobs/{id}` until `status` is `done` or `failed`, then open the returned `url`.\n\n**Auth:** when the server sets `COMEBLOG_API_KEY`, send it in the `X-API-Key` header (use *Authorize* above).\nGeneration and mutation endpoints are rate limited per client IP and return `429` with `Retry-After`.\n",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Liveness probe",
        "description": "Always unauthenticated and cheap; use it for container or load-balancer health checks.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ollama/check": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Check the local model server",
        "description": "Confirms Ollama is running and the configured writer model responds.",
        "operationId": "ollama_check_ollama_check_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid X-API-Key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate or queue limit hit; see Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Ollama is not reachable or the model is missing.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/preview": {
      "post": {
        "tags": [
          "Generation"
        ],
        "summary": "Preview the research for a topic",
        "description": "Runs only the research step (no language model), so it returns quickly. Results are cached for 15 minutes.",
        "operationId": "preview_preview_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TopicRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PreviewResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid X-API-Key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate or queue limit hit; see Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Research providers failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/blogs": {
      "post": {
        "tags": [
          "Generation"
        ],
        "summary": "Start generating a blog post",
        "description": "Queues a generation job and returns immediately with `202`. Poll `GET /jobs/{id}`.\n\nGeneration takes minutes on a CPU-only machine. If the queue is full the API answers `429` with `Retry-After`.",
        "operationId": "create_blog_blogs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBlogRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid X-API-Key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate or queue limit hit; see Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/jobs/{job_id}": {
